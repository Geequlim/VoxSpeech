develop:
  actions:
    - name: cli
      description: 运行 VoxSpeech 开发态 CLI，后续参数原样传递给 Commander
      command: node --import tsx apps/cli/src/main.ts
    - name: daemon
      description: 使用 VOXSPEECH_ENGINE 指定的原生引擎运行开发态 daemon
      command: node --import tsx apps/daemon/src/main.ts
    - name: preview
      description: 使用当前模型和 Voice 合成并立即播放，后续参数传给 speak
      command: node --import tsx apps/cli/src/main.ts speak --play
      actions:
        - name: sample
          description: 合成固定中文评测句，播放并保存到 /tmp/voxspeech-preview.wav
          command: node --import tsx apps/cli/src/main.ts speak "你好，这里是 VoxSpeech 语音效果测试。现在将检查音色、语速、停顿和中文表达是否自然。" --play --output /tmp/voxspeech-preview.wav
        - name: save
          description: 合成自定义文本，播放并保存到 /tmp/voxspeech-preview.wav
          command: node --import tsx apps/cli/src/main.ts speak --play --output /tmp/voxspeech-preview.wav
        - name: status
          description: 显示测试所用 daemon、engine 和模型状态
          command: node --import tsx apps/cli/src/main.ts status
        - name: models
          description: 显示可用于测试的模型
          command: node --import tsx apps/cli/src/main.ts model list
        - name: voices
          description: 显示可用于测试的 Voice
          command: node --import tsx apps/cli/src/main.ts voice list
    - name: model
      description: 模型开发工具
      actions:
        - name: download
          description: 运行原生 probe 模型下载工具
          command: node native/engine/probe/download-models.ts
    - name: typecheck
      description: 执行 TypeScript 类型检查
      command: yarn tsc -p tsconfig.json
    - name: test
      description: 执行 Vitest 单元测试
      command: yarn vitest run
      actions:
        - name: native
          description: 构建并执行 C++ 协议测试
          command:
            - cmake -S . -B dist/native -G Ninja -DCMAKE_BUILD_TYPE=Debug
            - cmake --build dist/native
            - ctest --test-dir dist/native --output-on-failure
    - name: lint
      description: 使用 Oxlint 执行静态代码分析
      command: yarn oxlint -c oxlint.config.mts -f stylish apps packages
      actions:
        - name: fix
          description: 自动修复 Oxlint 问题
          command: yarn oxlint -c oxlint.config.mts -f stylish apps packages --fix
    - name: format
      description: 使用 Oxfmt 格式化项目文件
      command: yarn oxfmt apps packages docs README.md AGENTS.md package.json tsconfig.base.json tsconfig.json oxlint.config.mts
      actions:
        - name: check
          description: 检查项目格式
          command: yarn oxfmt --check apps packages docs README.md AGENTS.md package.json tsconfig.base.json tsconfig.json oxlint.config.mts
    - name: check
      description: 执行完整质量检查
      command:
        - yarn tiny typecheck
        - yarn tiny lint
        - yarn tiny format/check
        - yarn tiny test
        - yarn tiny test/native
    - name: fix-worktree
      description: 规范化工作区
      command:
        - yarn tiny lint/fix
        - yarn tiny format
