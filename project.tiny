develop:
  actions:
    - name: cli
      description: 运行 VoxSpeech 开发态 CLI，后续参数原样传递给 Commander
      command: env XDG_CONFIG_HOME=.cache/voxspeech/dev/config XDG_DATA_HOME=.cache/voxspeech/dev/data XDG_CACHE_HOME=.cache/voxspeech/dev/cache node --import tsx apps/cli/src/main.ts
    - name: daemon
      description: 前台运行真实开发 daemon 并持续输出日志，Ctrl+C 停止
      command: env XDG_CONFIG_HOME=.cache/voxspeech/dev/config XDG_DATA_HOME=.cache/voxspeech/dev/data XDG_CACHE_HOME=.cache/voxspeech/dev/cache node --import tsx tools/dev-daemon.mts
    - name: native
      description: 管理仓库缓存中的模型和原生构建产物
      actions:
        - name: models
          description: 下载两个正式模型和 tokenizer 到仓库 .cache/voxspeech/models
          command: node native/engine/probe/download-models.ts native/engine/probe/model-manifest.json --output-dir .cache/voxspeech/models
        - name: build
          description: 增量构建 CPU、CUDA、Vulkan 全部原生产物
          command: node --import tsx tools/native-build.mts
          actions:
            - name: cpu
              description: 增量构建 CPU 原生产物
              command: node --import tsx tools/native-build.mts cpu
            - name: cuda
              description: 增量构建 CUDA 原生产物
              command: node --import tsx tools/native-build.mts cuda
            - name: vulkan
              description: 增量构建 Vulkan 原生产物
              command: node --import tsx tools/native-build.mts vulkan
    - name: typecheck
      description: 执行 TypeScript 类型检查
      command: yarn tsc -p tsconfig.json
    - name: test
      description: 执行 Vitest 单元测试
      command: yarn vitest run
      actions:
        - name: native
          description: 构建并执行 C++ 协议测试
          command:
            - cmake -S . -B dist/native -G Ninja -DCMAKE_BUILD_TYPE=Debug
            - cmake --build dist/native
            - ctest --test-dir dist/native --output-on-failure
    - name: lint
      description: 使用 Oxlint 执行静态代码分析
      command: yarn oxlint -c oxlint.config.mts -f stylish apps packages tools
      actions:
        - name: fix
          description: 自动修复 Oxlint 问题
          command: yarn oxlint -c oxlint.config.mts -f stylish apps packages tools --fix
    - name: format
      description: 使用 Oxfmt 格式化项目文件
      command: yarn oxfmt apps packages tools docs README.md AGENTS.md package.json tsconfig.base.json tsconfig.json oxlint.config.mts
      actions:
        - name: check
          description: 检查项目格式
          command: yarn oxfmt --check apps packages tools docs README.md AGENTS.md package.json tsconfig.base.json tsconfig.json oxlint.config.mts
    - name: check
      description: 执行完整质量检查
      command:
        - yarn tiny typecheck
        - yarn tiny lint
        - yarn tiny format/check
        - yarn tiny test
        - yarn tiny test/native
    - name: fix-worktree
      description: 规范化工作区
      command:
        - yarn tiny lint/fix
        - yarn tiny format
